# =============================================================================
# Eleitor Consciente 2026 - .gitignore
# =============================================================================

# === Variaveis de Ambiente (CREDENCIAIS) ===
.env
.env.local
.env.*.local
.env.backup

# === Dependencias ===
/vendor/
/node_modules/

# === Cache e Testes ===
/.phpunit.cache/
/tests/.phpunit.cache/
.phpunit.result.cache
composer.lock

# === Logs ===
/storage/logs/*.log
*.log

# === Armazenamento Temporario ===
/storage/cache/*
/storage/imports/*

# === Fotos dos Candidatos (arquivos grandes) ===
/database/foto_cand*/

# === Symlinks das fotos ===
/public/fotos
/public/fotos_br

# === Dump do Banco (gerado por scripts) ===
/build/eleitor_consciente_dump.sql

# === Arquivos do Sistema Operacional ===
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# === IDEs e Editores ===
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.project
.settings/
.classpath
*.iml

# === Docker (ambiente local) ===
docker-compose.override.yml

# === Backup local ===
*.sql.gz
*.sql.bak

# === Chaves SSH e Certificados ===
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_ed25519

# === Outros ===
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env.development.local
.env.test.local
.env.production.local
