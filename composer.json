{
    "name": "eleitor-consciente/eleitor-consciente-2026",
    "description": "Plataforma pública e neutra de informação eleitoral para 2026",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Importer\\": "importer/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php importer/cli.php migrate",
        "seed": "php importer/cli.php seed"
    }
}

