# =============================================================================
# Eleitor Consciente 2026 - Variáveis de Ambiente (Produção)
# Copie este arquivo para .env e preencha os valores reais
# NUNCA versione o arquivo .env com valores reais!
# =============================================================================

# --- Aplicação ---
APP_NAME="Eleitor Consciente 2026"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seu-dominio.com.br

# --- Banco de Dados MySQL ---
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=eleitor_consciente
DB_USERNAME=eleitor_user
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_ROOT_PASSWORD

# --- Chave de Administração (para importação via API) ---
# Gere uma chave forte: openssl rand -hex 32
ADMIN_API_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# --- NVIDIA AI Endpoints (Opcional) ---
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_MAX_TOKENS=1024
NVIDIA_TEMPERATURE=0.7

# --- Backup ---
BACKUP_DIR=/var/backups/eleitor_consciente
BACKUP_RETENTION_DAYS=30
